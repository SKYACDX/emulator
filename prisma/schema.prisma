// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PatchFormat {
  IPS
  BPS
  UPS
  XDELTA
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  // R2 object key, not a URL — signed URLs expire, so a fresh one is
  // generated at render time via getAvatarUrl() instead of storing one.
  avatarKey    String?
  createdAt    DateTime @default(now())

  // TOTP two-factor auth. totpSecret is encrypted at rest (see src/lib/totp.ts)
  // and totpPendingSecret holds a not-yet-confirmed secret during setup.
  totpEnabled       Boolean @default(false)
  totpSecret        String?
  totpPendingSecret String?

  // Visual theme id from src/lib/themes.tsx (validated server-side against
  // that registry). "custom" activates the customTheme* hex colors below
  // instead of a preset.
  theme               String  @default("default")
  customThemeBg       String?
  customThemeSurface  String?
  customThemeAccent   String?
  customThemeText     String?

  hacks               Hack[]
  sharedFiles         SharedFile[]
  fileReports         FileReport[]
  communityThemes     CommunityTheme[]
  apiTokens           ApiToken[]
  gameSaves           GameSave[]
  createdCommunities  Community[]
  communityMemberships CommunityMembership[]
  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")
  communityPosts         CommunityPost[]
  conversations          ConversationParticipant[]
  messages               Message[]
  emulatorThemes         EmulatorTheme[]
  appFeedback            AppFeedback[]
  passkeys               Passkey[]
  loginAttempts          LoginAttempt[]
  downloadLogs           DownloadLog[]
}

// A registered WebAuthn credential (Face ID, fingerprint, or a physical
// security key). Login with one skips the password AND TOTP entirely —
// the authenticator itself is already phishing-resistant multi-factor.
model Passkey {
  id           String   @id @default(cuid())
  // Base64url-encoded credential ID from the authenticator — how we look
  // up which user is signing in for a discoverable ("usernameless") login.
  credentialId String   @unique
  publicKey    Bytes
  // Signature counter for clone detection: must strictly increase on every
  // use, or a cloned authenticator is signing in instead of the real one.
  counter      BigInt
  deviceType   String
  backedUp     Boolean
  transports   String[]
  name         String? // user-given label, e.g. "iPhone de Juan"
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Every login attempt (password, TOTP step, passkey, or the native app's
// token endpoint), success or failure, shown back to the user on
// /me/security so they can notice if someone's been trying their account.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  method    String // "password" | "totp" | "passkey" | "app-token"
  ip        String
  userAgent String?
  createdAt DateTime @default(now())

  // Null when the email didn't match any account — still worth recording,
  // just not linkable to a user's own security page.
  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
}

// A conversation is a DM (isGroup=false, exactly 2 participants) or a group
// chat (isGroup=true, any number, has a name). Text-only by design — no
// attachments model at all, so file-sharing can't sneak in later.
model Conversation {
  id        String   @id @default(cuid())
  isGroup   Boolean  @default(false)
  name      String?
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Friendship {
  id        String   @id @default(cuid())
  status    String   @default("pending") // "pending" | "accepted"
  createdAt DateTime @default(now())

  requesterId String
  requester   User   @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User   @relation("FriendshipAddressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Community {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  createdAt   DateTime @default(now())

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])
  members   CommunityMembership[]
  posts     CommunityPost[]
}

model CommunityPost {
  id        String   @id @default(cuid())
  body      String
  // R2 object key for an optional attached image, same pattern as
  // User.avatarKey — a fresh signed URL is generated at render time.
  imageKey  String?
  createdAt DateTime @default(now())

  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])

  @@index([communityId])
}

model CommunityMembership {
  id       String   @id @default(cuid())
  role     String   @default("member") // "owner" | "member"
  joinedAt DateTime @default(now())

  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityTheme {
  id        String   @id @default(cuid())
  name      String
  bg        String
  surface   String
  accent    String
  text      String
  createdAt DateTime @default(now())

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
}

// Visual theme for the companion emulator app's on-screen controls — not
// to be confused with CommunityTheme above (this site's own color scheme).
// v1 is presets + color only, per docs/themes-api.md from the app repo:
// `assets` (per-piece custom images) is a v2 feature and deliberately has
// no column here yet — the API layer fills it with nulls to match the
// documented response shape without the site needing to store/serve it.
model EmulatorTheme {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  system    String // Platform.slug this theme is for (gb, gbc, gba, nds, ...)
  isPublic  Boolean  @default(true)
  downloads Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shellBackground     String
  shellBorder         String
  screenBezel         String
  dpadColor           String
  actionButtonColor   String
  shoulderButtonColor String

  // Preset IDs the app resolves client-side — the server never interprets
  // these, just stores and returns the string (see the doc's "Catálogo de
  // presets" section).
  dpadPreset            String
  actionButtonsPreset   String
  shoulderButtonsPreset String

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([system])
  @@index([authorId])
}

// Public listing page for the companion app (multiemu) — not a user
// collection like Hack/SharedFile/EmulatorTheme, there's exactly one of
// these. Editable only by staff (see /api/app), unlike everything else a
// regular account can create. Per docs/applistingapi.md from the app repo.
model AppListing {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  features    String[]
  // R2 object key for the icon — same pattern as User.avatarKey, a fresh
  // signed URL is generated at render time instead of storing one.
  iconKey     String?
  updatedAt   DateTime @updatedAt

  screenshots AppScreenshot[]
  releases    AppRelease[]
}

model AppScreenshot {
  id         String   @id @default(cuid())
  storedName String
  createdAt  DateTime @default(now())

  listingId String
  listing   AppListing @relation(fields: [listingId], references: [id])

  @@index([listingId])
}

model AppRelease {
  id            String      @id @default(cuid())
  version       String
  versionCode   Int         @unique
  changelog     String
  // Null for WINDOWS releases — only ANDROID builds have an SDK floor.
  minAndroidSdk Int?
  platform      AppPlatform @default(ANDROID)
  apkKey        String?
  apkSize       Int         @default(0)
  downloads     Int         @default(0)
  publishedAt   DateTime    @default(now())

  listingId String
  listing   AppListing @relation(fields: [listingId], references: [id])

  @@index([listingId])
  @@index([listingId, platform])
}

enum AppPlatform {
  ANDROID
  WINDOWS
}

// Feedback on the multiemu app, shown publicly on /app. Requires an
// account, same as every other piece of user-generated content on the
// site — keeps it consistent with community posts/reports instead of
// allowing anonymous spam.
model AppFeedback {
  id         String  @id @default(cuid())
  body       String
  // Free text the sender types, e.g. "Samsung Galaxy S21, Android 13" —
  // deliberately not a structured device/OS pair, since the exact wording
  // varies by platform and this is just a bug-report aid, not queried on.
  deviceInfo String?
  appVersion String?
  // R2 object key for an optional screenshot — same pattern as
  // CommunityPost.imageKey (signed URL generated at render time).
  imageKey   String?
  createdAt  DateTime @default(now())

  // Guests can leave feedback too (no account required, just nudged to
  // create one) — authorId is null and guestName holds whatever name they
  // typed, or nothing at all.
  authorId  String?
  author    User?   @relation(fields: [authorId], references: [id])
  guestName String?

  @@index([authorId])
}

// The public "Contacto" form — deliberately no auth required (a visitor
// without an account should still be able to reach the team) and no
// relation to User; just a message with a reply-to email the sender types.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

model Platform {
  id   String @id @default(cuid())
  slug String @unique
  name String

  games       Game[]
  sharedFiles SharedFile[]
}

model Game {
  id            String  @id @default(cuid())
  slug          String  @unique
  title         String
  platformId    String
  coverImageUrl String?

  platform Platform @relation(fields: [platformId], references: [id])
  hacks    Hack[]

  @@index([platformId])
}

model Hack {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  createdAt   DateTime @default(now())

  gameId   String
  authorId String

  game    Game    @relation(fields: [gameId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])
  patches Patch[]

  @@index([gameId])
  @@index([authorId])
}

model SharedFile {
  id           String   @id @default(cuid())
  title        String
  description  String
  originalName String
  storedName   String
  fileSize     Int
  mimeType     String
  isPublic     Boolean  @default(true)
  downloadCount Int     @default(0)
  createdAt    DateTime @default(now())

  // "clean" | "malicious" (never actually stored — rejected outright) |
  // "pending" | "error" | "skipped" (no scanner configured, or file too
  // big for the free-tier scan). See src/lib/virustotal.ts.
  virusScanStatus String @default("skipped")

  // Optional tagging so a general-purpose file can say what it's about:
  // a platform (Game Boy, NDS, ...) and/or a free-text game name, without
  // requiring it to be linked to an actual Game/Hack record.
  platformId    String?
  gameTitle     String?
  coverImageUrl String?
  platform      Platform? @relation(fields: [platformId], references: [id])

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id])

  reports FileReport[]
  downloads DownloadLog[]

  @@index([uploaderId])
  @@index([platformId])
}

model FileReport {
  id        String   @id @default(cuid())
  reason    String
  createdAt DateTime @default(now())

  sharedFileId String
  sharedFile   SharedFile @relation(fields: [sharedFileId], references: [id])
  reporterId   String
  reporter     User       @relation(fields: [reporterId], references: [id])

  @@unique([sharedFileId, reporterId])
  @@index([sharedFileId])
}

model Patch {
  id           String      @id @default(cuid())
  version      String
  format       PatchFormat
  originalName String
  storedName   String
  fileSize     Int
  sha256       String
  releaseNotes String
  downloadCount Int        @default(0)
  createdAt    DateTime    @default(now())

  hackId String
  hack   Hack   @relation(fields: [hackId], references: [id])

  downloads DownloadLog[]

  @@index([hackId])
}

// One row per download of a SharedFile or Patch (exactly one of the two is
// set). userId is null for anonymous downloads — still worth recording.
model DownloadLog {
  id        String   @id @default(cuid())
  ip        String
  userAgent String?
  createdAt DateTime @default(now())

  sharedFileId String?
  sharedFile   SharedFile? @relation(fields: [sharedFileId], references: [id], onDelete: Cascade)
  patchId      String?
  patch        Patch?      @relation(fields: [patchId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sharedFileId])
  @@index([patchId])
  @@index([userId])
}

/// Long-lived bearer tokens for the companion emulator app — a native app
/// can't use the browser session cookie, so it logs in once via
/// POST /api/auth/token and stores this instead.
model ApiToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Cloud save sync for the emulator app. `gameKey` is a client-chosen
/// identifier for which game a save belongs to (the app decides the
/// scheme, e.g. platform+title or a ROM hash) — this API only stores
/// save data, never ROMs.
model GameSave {
  id           String   @id @default(cuid())
  gameKey      String
  slot         Int      @default(0)
  originalName String
  storedName   String
  fileSize     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, gameKey, slot])
  @@index([userId])
}
