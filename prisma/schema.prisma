// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PatchFormat {
  IPS
  BPS
  UPS
  XDELTA
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  // R2 object key, not a URL — signed URLs expire, so a fresh one is
  // generated at render time via getAvatarUrl() instead of storing one.
  avatarKey    String?
  createdAt    DateTime @default(now())

  // TOTP two-factor auth. totpSecret is encrypted at rest (see src/lib/totp.ts)
  // and totpPendingSecret holds a not-yet-confirmed secret during setup.
  totpEnabled       Boolean @default(false)
  totpSecret        String?
  totpPendingSecret String?

  // Visual theme id from src/lib/themes.tsx (validated server-side against
  // that registry). "custom" activates the customTheme* hex colors below
  // instead of a preset.
  theme               String  @default("default")
  customThemeBg       String?
  customThemeSurface  String?
  customThemeAccent   String?
  customThemeText     String?

  hacks               Hack[]
  sharedFiles         SharedFile[]
  fileReports         FileReport[]
  communityThemes     CommunityTheme[]
  apiTokens           ApiToken[]
  gameSaves           GameSave[]
  createdCommunities  Community[]
  communityMemberships CommunityMembership[]
}

model Community {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  createdAt   DateTime @default(now())

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])
  members   CommunityMembership[]
}

model CommunityMembership {
  id       String   @id @default(cuid())
  role     String   @default("member") // "owner" | "member"
  joinedAt DateTime @default(now())

  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityTheme {
  id        String   @id @default(cuid())
  name      String
  bg        String
  surface   String
  accent    String
  text      String
  createdAt DateTime @default(now())

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
}

model Platform {
  id   String @id @default(cuid())
  slug String @unique
  name String

  games       Game[]
  sharedFiles SharedFile[]
}

model Game {
  id            String  @id @default(cuid())
  slug          String  @unique
  title         String
  platformId    String
  coverImageUrl String?

  platform Platform @relation(fields: [platformId], references: [id])
  hacks    Hack[]

  @@index([platformId])
}

model Hack {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  createdAt   DateTime @default(now())

  gameId   String
  authorId String

  game    Game    @relation(fields: [gameId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])
  patches Patch[]

  @@index([gameId])
  @@index([authorId])
}

model SharedFile {
  id           String   @id @default(cuid())
  title        String
  description  String
  originalName String
  storedName   String
  fileSize     Int
  mimeType     String
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // "clean" | "malicious" (never actually stored — rejected outright) |
  // "pending" | "error" | "skipped" (no scanner configured, or file too
  // big for the free-tier scan). See src/lib/virustotal.ts.
  virusScanStatus String @default("skipped")

  // Optional tagging so a general-purpose file can say what it's about:
  // a platform (Game Boy, NDS, ...) and/or a free-text game name, without
  // requiring it to be linked to an actual Game/Hack record.
  platformId    String?
  gameTitle     String?
  coverImageUrl String?
  platform      Platform? @relation(fields: [platformId], references: [id])

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id])

  reports FileReport[]

  @@index([uploaderId])
  @@index([platformId])
}

model FileReport {
  id        String   @id @default(cuid())
  reason    String
  createdAt DateTime @default(now())

  sharedFileId String
  sharedFile   SharedFile @relation(fields: [sharedFileId], references: [id])
  reporterId   String
  reporter     User       @relation(fields: [reporterId], references: [id])

  @@unique([sharedFileId, reporterId])
  @@index([sharedFileId])
}

model Patch {
  id           String      @id @default(cuid())
  version      String
  format       PatchFormat
  originalName String
  storedName   String
  fileSize     Int
  sha256       String
  releaseNotes String
  createdAt    DateTime    @default(now())

  hackId String
  hack   Hack   @relation(fields: [hackId], references: [id])

  @@index([hackId])
}

/// Long-lived bearer tokens for the companion emulator app — a native app
/// can't use the browser session cookie, so it logs in once via
/// POST /api/auth/token and stores this instead.
model ApiToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Cloud save sync for the emulator app. `gameKey` is a client-chosen
/// identifier for which game a save belongs to (the app decides the
/// scheme, e.g. platform+title or a ROM hash) — this API only stores
/// save data, never ROMs.
model GameSave {
  id           String   @id @default(cuid())
  gameKey      String
  slot         Int      @default(0)
  originalName String
  storedName   String
  fileSize     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, gameKey, slot])
  @@index([userId])
}
